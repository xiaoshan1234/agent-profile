{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes role manifest",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "description", "soul", "skills"],
      "properties": {
        "schema": {
          "const": 2
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "soul": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    {
      "type": "object",
      "required": ["schema", "name", "description", "soul", "skills"],
      "properties": {
        "schema": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "soul": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
