{
  "schema": 1,
  "max_per_day": 6,
  "max_per_role": 2,
  "min_score": 3,
  "search_limit": 10,
  "notes": "单关键词查询（多词查询在 registry 里几乎命中不了）；keywords 用于命中打分，命中 >= min_score 才收。domain 决定技能落进 skills/<domain>/。",
